# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---- HISSATI additions ----
# Secrets: never commit real keys. Only .env.example is tracked.
!.env.example
.env.local
.env.*.local
supabase/.env
# Local Supabase data volumes and generated backups
supabase/volumes/data/
supabase/volumes/storage/
backups/
*.bundle
*.tar.gz
