# Copy to .env.local and fill in. NEVER commit real values.
# For local dev, `npm run db:up` writes .env.local for you automatically.

# Supabase project (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# School-only sign-up: teachers need this code to create an account (server-only, keep it private)
SCHOOL_CODE=choose-a-code
# Shown on the login/sign-up pages
SCHOOL_NAME=اسم مدرستك

# AI extraction: "anthropic" (real Claude Vision) or "mock" (clearly-labelled sample data, no API call)
AI_PROVIDER=mock
# Server-only. Required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=
